library(shiny)
# ================= DATA =================
doctors <- data.frame(
id = "D1",
username = "doctor1",
password = "1234"
)
courses <- data.frame(
course_id = "C1",
course_name = "Linear Algebra",
doctor_id = "D1"
)
schedule <- data.frame(
course_id = c("C1","C1"),
week = c(1,1),
day = c("Sunday","Tuesday"),
time = c("10:00","12:00")
)
# ================= UI (UNCHANGED) =================
ui <- fluidPage(
tags$head(
tags$style(HTML("
body {
background-color: #0f172a;
color: white;
font-family: Arial;
}
.title {
text-align: center;
font-size: 32px;
font-weight: bold;
margin-top: 20px;
color: #38bdf8;
}
.box {
background-color: #1e293b;
padding: 20px;
border-radius: 15px;
width: 60%;
margin: auto;
margin-top: 30px;
box-shadow: 0px 0px 15px rgba(0,0,0,0.5);
text-align: center;
}
img {
display: block;
margin-left: auto;
margin-right: auto;
width: 120px;
border-radius: 10px;
}
select {
width: 80%;
padding: 8px;
margin: 5px;
}
"))
),
div(class = "title", "AI Lecture Emotion System"),
uiOutput("page")
)
# ================= SERVER =================
server <- function(input, output, session) {
logged_in <- reactiveVal(FALSE)
attempts <- reactiveVal(0)
# 👇 الدكتور الحالي بعد تسجيل الدخول
current_doctor <- reactiveVal(NULL)
# ---------------- LOGIN UI ----------------
login_page <- function() {
div(class = "box",
img(src = "https://cdn-icons-png.flaticon.com/512/4712/4712109.png"),
h4("Doctor Login 👨‍🏫"),
textInput("username", "Username"),
passwordInput("password", "Password"),
actionButton("login", "Login"),
uiOutput("result")
)
}
# ---------------- DASHBOARD ----------------
dashboard_page <- function() {
req(current_doctor())
doc_id <- current_doctor()
# courses الخاصة بالدكتور فقط
doc_courses <- courses[courses$doctor_id == doc_id, ]
div(class = "box",
h3("Dashboard 📊"),
selectInput("course", "Select Course",
choices = doc_courses$course_name),
selectInput("week", "Select Week",
choices = 1:15),
uiOutput("schedule"),
br(),
actionButton("start", "Start Session")
)
}
# ---------------- SWITCH PAGE ----------------
output$page <- renderUI({
if (logged_in()) dashboard_page() else login_page()
})
# ---------------- LOGIN ----------------
observeEvent(input$login, {
row <- doctors[
doctors$username == input$username &
doctors$password == input$password, ]
if (nrow(row) == 1) {
logged_in(TRUE)
current_doctor(row$id)   # 🔥 هنا يتم ربط الدكتور تلقائيًا
attempts(0)
output$result <- renderUI(h4("Login Success ✅"))
} else {
attempts(attempts() + 1)
output$result <- renderUI(
h4(paste("Wrong login - Attempts:", attempts()))
)
if (attempts() >= 3) {
output$result <- renderUI(
h3("LOCKED ❌ Too many attempts")
)
}
}
})
# ---------------- SCHEDULE ----------------
output$schedule <- renderUI({
req(input$course, input$week, current_doctor())
doc_id <- current_doctor()
course_id <- courses$course_id[
courses$course_name == input$course &
courses$doctor_id == doc_id
]
sch <- schedule[
schedule$course_id == course_id &
schedule$week == as.numeric(input$week), ]
if (nrow(sch) == 0) return(h5("No sessions"))
tagList(
lapply(1:nrow(sch), function(i) {
tags$div(paste(sch$day[i], "-", sch$time[i]))
})
)
})
}
shinyApp(ui, server)
